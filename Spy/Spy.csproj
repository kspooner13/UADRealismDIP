<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Spy</RootNamespace>
    <AssemblyName>Spy</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <!-- Optional: set OutputPath to game Mods folder (adjust path for your install) -->
    <!-- <OutputPath>F:\Games\Ultimate.Admiral.Dreadnoughts.1.7.0.0\game\Mods\</OutputPath> -->
        <OutputPath>F:\Games\Ultimate.Admiral.Dreadnoughts.1.7.0.0\game\Mods\</OutputPath>
  </PropertyGroup>

  <!-- Copy TAF DLL into Spy folder before build if not present (from TAF_Nightly) -->
  <Target Name="EnsureTafDll" BeforeTargets="ResolveAssemblyReferences">
    <Copy SourceFiles="$(ProjectDir)..\TweaksAndFixes\TAF_Nightly\TweaksAndFixes.dll"
          DestinationFiles="$(ProjectDir)TweaksAndFixes.dll"
          SkipUnchangedFiles="true"
          Condition="Exists('$(ProjectDir)..\TweaksAndFixes\TAF_Nightly\TweaksAndFixes.dll')" />
  </Target>

  <ItemGroup>
    <!-- Reference TAF from DLL in this folder (Spy). Build TweaksAndFixes first or run EnsureTafDll. -->
